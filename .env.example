# Copie para .env. Nada aqui é obrigatório — os defaults casam com a infra local.

# ---------- cérebro ----------
# claude = CLI como subprocesso, com ferramentas reais (custa da assinatura)
# ollama = local, de graça, sem ferramenta nenhuma
BRAIN=claude
# Onde o assistente opera. Vazio = só o diretório do espatial-os, que não é repo git —
# então `git status` não teria o que responder. Aponte para o repo que você quer assistir.
AGENT_CWD=
AGENT_MODEL=
AGENT_MAX_TURNS=14
AGENT_MCP_CONFIG=

# Permissões, skills e agentes NÃO ficam aqui: são editados no painel `P` da UI e
# persistidos em .cache/config.json. As duas variáveis abaixo são só fallback de boot.
AGENT_PERMISSION_MODE=bypassPermissions
# Vazio = nenhum --allowedTools = todas as ferramentas liberadas.
AGENT_ALLOWED_TOOLS=

# ---------- memória ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=workspace_embedding
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- voz ----------
# TTS global do oracle (shared/speech.compose.yml). Suba com `make up nvidia speech` lá.
# Vozes pt-BR do Kokoro: pf_dora (fem), pm_alex, pm_santa (masc). /api/health lista as 67.
TTS_URL=http://localhost:8880
TTS_MODEL=kokoro
TTS_VOICE=pf_dora

# ---------- cérebro offline ----------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# ---------- satélites de busca ----------
# Sem chave o satélite aparece APAGADO na cena, não ausente.
#
# O SearXNG é global no oracle (shared/search.compose.yml) e não precisa de chave nenhuma:
# suba com `make up searxng` lá e aponte para o loopback dele. É o único provedor que
# atende sem cota e sem expor a pergunta a um terceiro comercial.
BRAVE_API_KEY=
SERPAPI_API_KEY=
SEARXNG_URL=http://localhost:8888

# ---------- servidor ----------
ESPATIAL_HOST=127.0.0.1
ESPATIAL_PORT=8787
# Raízes extras que o inspetor pode ler (separadas por :). Default: só este projeto.
FILE_ROOTS=
